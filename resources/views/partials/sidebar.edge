<aside class="app-sidebar w-64 shrink-0 p-4">
  <div class="app-sidebar-head mb-3 flex items-center justify-between px-1">
    <span class="app-sidebar-title text-xs font-semibold uppercase tracking-[0.12em]">Menu</span>
    <button id="sidebarToggle" type="button" class="btn btn-xs app-sidebar-toggle" aria-label="Colapsar menu lateral" aria-expanded="true">
      <svg class="app-sidebar-toggle-icon h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M12.5 4L7 10l5.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <ul class="menu app-menu rounded-box sticky top-4">
    <li>
      <a href="/" class="app-menu-link">
        <svg class="app-menu-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 9.4L10 4l7 5.4V16a1 1 0 01-1 1h-4v-4.2H8V17H4a1 1 0 01-1-1V9.4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        <span class="app-menu-text">Home</span>
      </a>
    </li>
    <li>
      <a href="/dashboard" class="app-menu-link">
        <svg class="app-menu-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="1.5"/>
          <rect x="11" y="3" width="6" height="10" rx="1.2" stroke="currentColor" stroke-width="1.5"/>
          <rect x="3" y="11" width="6" height="6" rx="1.2" stroke="currentColor" stroke-width="1.5"/>
          <rect x="11" y="15" width="6" height="2" rx="1" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span class="app-menu-text">Dashboard</span>
      </a>
    </li>
    @if(authPermissions?.includes('admin.access'))
      <li>
        <a href="/admin" class="app-menu-link">
          <svg class="app-menu-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 3.2l1.6 1.2 2-.3.9 1.8 1.9.8-.2 2 1.2 1.6-1.2 1.6.2 2-1.9.8-.9 1.8-2-.3L10 16.8l-1.6 1.2-2-.3-.9-1.8-1.9-.8.2-2-1.2-1.6L4 8.9l-.2-2 1.9-.8.9-1.8 2 .3L10 3.2z" stroke="currentColor" stroke-width="1.35"/>
            <circle cx="10" cy="10" r="2.2" stroke="currentColor" stroke-width="1.35"/>
          </svg>
          <span class="app-menu-text">Administración</span>
        </a>
      </li>
    @endif
    @if(authPermissions?.includes('users.read'))
      <li>
        <a href="/admin/users" class="app-menu-link">
          <svg class="app-menu-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="7" cy="7.2" r="2.3" stroke="currentColor" stroke-width="1.4"/>
            <circle cx="13.4" cy="8.2" r="1.9" stroke="currentColor" stroke-width="1.4"/>
            <path d="M3.8 15.5c.6-2.2 2.3-3.4 4.9-3.4s4.3 1.2 4.9 3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M12.1 14.9c.4-1.4 1.5-2.2 3.2-2.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <span class="app-menu-text">Usuarios</span>
        </a>
      </li>
    @endif
    @if(authPermissions?.includes('roles.read'))
      <li>
        <a href="/admin/roles" class="app-menu-link">
          <svg class="app-menu-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 3.5l6 3.2-6 3.2-6-3.2 6-3.2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M4 10.2l6 3.2 6-3.2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M4 13.6l6 3 6-3" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
          <span class="app-menu-text">Roles</span>
        </a>
      </li>
    @endif
    @if(authPermissions?.includes('permissions.read'))
      <li>
        <a href="/admin/permissions" class="app-menu-link">
          <svg class="app-menu-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M8.1 9.1a2.2 2.2 0 113.1 3.1l-2.7 2.7a2.2 2.2 0 11-3.1-3.1l1.2-1.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M11.9 10.9a2.2 2.2 0 01-3.1-3.1l2.7-2.7a2.2 2.2 0 013.1 3.1l-1.2 1.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <span class="app-menu-text">Permisos</span>
        </a>
      </li>
    @endif
    @if(authPermissions?.includes('audit_logs.read'))
      <li>
        <a href="/admin/audit-logs" class="app-menu-link">
          <svg class="app-menu-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="6.6" stroke="currentColor" stroke-width="1.4"/>
            <path d="M10 6.6V10l2.3 1.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="app-menu-text">Audit Logs</span>
        </a>
      </li>
    @endif
  </ul>
</aside>
<nav class="navbar bg-base-100 border-b border-base-300 px-4">
  <div class="flex-1">
    <a class="btn btn-ghost text-lg font-bold" href="/">
      <span class="badge badge-primary">AFE</span>
      <span class="ml-2">proyecto-catedra-afe</span>
    </a>
  </div>

  <div class="flex-none gap-2">
    <button id="themeToggle" class="btn btn-outline btn-sm">
      Cambiar tema
    </button>
  </div>

  <div class="flex-none gap-2">
    @if(authUser)
    <span class="badge badge-success badge-sm">
        Bienvenido {{ authUser?.fullName || authUser?.email || 'Usuario' }}
    </span>
    @endif
    @if(authUser)
      <form method="POST" action="/logout">
        @if(typeof csrfField === 'function')
          {{ csrfField() }}
        @endif
        <button class="btn btn-ghost btn-sm" type="submit">Logout</button>
      </form>
    @endif
  </div>
</nav>
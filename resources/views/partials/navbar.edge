<nav class="app-navbar navbar px-4 md:px-6">
  <div class="flex-1">
    <a class="app-brand btn btn-ghost text-lg font-bold" href="/">
      <span class="badge border-white/20 bg-white/10 text-white">AFE</span>
      <span class="ml-2">proyecto-catedra-afe</span>
    </a>
  </div>

  <div class="flex-none items-center gap-2">
    <button id="themeToggle" class="btn btn-sm border-white/20 bg-white/5 text-white hover:bg-white/10">
      Cambiar tema
    </button>
  </div>

  <div class="flex-none items-center gap-2">
    @if(authUser)
    <span class="badge border-white/20 bg-white/10 text-white badge-sm">
        Bienvenido {{ authUser?.fullName || authUser?.email || 'Usuario' }}
    </span>
    @endif
    @if(authUser)
      <form method="POST" action="/logout">
        @if(typeof csrfField === 'function')
          {{ csrfField() }}
        @endif
        <button class="btn btn-sm border-white/20 bg-white/5 text-white hover:bg-white/10" type="submit">Logout</button>
      </form>
    @endif
  </div>

@component('../views/components/layouts/app', { title: 'Admin Permissions - proyecto-catedra-afe' })
  <div class="permissions-page page-stack">
    @if(flashMessages.get('success'))
      <div class="alert alert-success">
        <span>{{ flashMessages.get('success') }}</span>
      </div>
    @endif

    @if(flashMessages.get('error'))
      <div class="alert alert-error">
        <span>{{ flashMessages.get('error') }}</span>
      </div>
    @endif

    <div class="surface-card">
      <div class="surface-card-body">
        <section class="permissions-hero rounded-2xl p-5 md:p-6 lg:p-7">
          <div class="permissions-hero-grid gap-5 lg:gap-8">
            <div>
              <p class="permissions-kicker">Autorización granular</p>
              <h1 class="permissions-title mt-2">Gestión de permisos</h1>
              <p class="permissions-lead mt-3">
                Define capacidades específicas del sistema y su relación con los roles para mantener control
                preciso de cada operación.
              </p>
            </div>

            <div class="permissions-actions flex flex-wrap items-center justify-end gap-2">
              @if(authPermissions?.includes('permissions.manage'))
                <button
                  class="btn app-fixed-btn app-fixed-create permissions-action-btn min-w-44"
                  type="button"
                  onclick="document.getElementById('create-permission-modal')?.showModal()"
                >
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 4v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                  Nuevo Permiso
                </button>
              @endif
              <a class="btn app-fixed-btn app-fixed-view permissions-action-btn" href="/admin/roles">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3.5 10h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M10.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Ver Roles
              </a>
            </div>
          </div>
        </section>

        <section class="permissions-kpi-grid mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <article class="permissions-kpi-card rounded-xl p-4">
            <p class="permissions-kpi-label">Total permisos</p>
            <p class="permissions-kpi-value">{{ permissionStats.totalPermissions }}</p>
          </article>

          <article class="permissions-kpi-card rounded-xl p-4">
            <p class="permissions-kpi-label">Asignados a roles</p>
            <p class="permissions-kpi-value">{{ permissionStats.permissionsWithRoles }}</p>
          </article>

          <article class="permissions-kpi-card rounded-xl p-4">
            <p class="permissions-kpi-label">Sin roles</p>
            <p class="permissions-kpi-value">{{ permissionStats.permissionsWithoutRoles }}</p>
          </article>

          <article class="permissions-kpi-card rounded-xl p-4">
            <p class="permissions-kpi-label">Roles disponibles</p>
            <p class="permissions-kpi-value">{{ permissionStats.totalRoles }}</p>
          </article>
        </section>
      </div>
    </div>

    @if(authPermissions?.includes('permissions.manage'))
      <dialog id="create-permission-modal" class="modal">
        <div class="modal-box max-w-3xl app-form-panel app-modal-solid">
          <h3 class="card-title app-section-title">Crear permiso</h3>
          <p class="page-subtitle mt-1">Los permisos controlan acceso granular a funciones del sistema.</p>

          <form class="app-form-grid mt-3 grid gap-4 md:grid-cols-2" method="POST" action="/admin/permissions">
            @if(typeof csrfField === 'function')
              {{ csrfField() }}
            @endif

            <label class="app-form-field form-control">
              <div class="label"><span class="label-text">Slug</span></div>
              <input
                name="slug"
                type="text"
                class="input input-bordered app-strong-input w-full @if(errors?.has('slug')) input-error @endif"
                required
                value="{{ errors?.has('slug') ? (old('slug') || '') : '' }}"
              />
              <div class="label"><span class="label-text-alt">Usa minúsculas, puntos o guiones. Ejemplo: reports.export</span></div>
              @if(errors?.has('slug'))
                <div class="label"><span class="label-text-alt text-error">{{ errors.first('slug') }}</span></div>
              @endif
            </label>

            <label class="app-form-field form-control">
              <div class="label"><span class="label-text">Nombre</span></div>
              <input
                name="name"
                type="text"
                class="input input-bordered app-strong-input w-full @if(errors?.has('name')) input-error @endif"
                required
                value="{{ errors?.has('name') ? (old('name') || '') : '' }}"
              />
              @if(errors?.has('name'))
                <div class="label"><span class="label-text-alt text-error">{{ errors.first('name') }}</span></div>
              @endif
            </label>

            <div class="md:col-span-2 flex justify-end gap-2">
              <button
                class="btn app-fixed-btn app-fixed-cancel permissions-action-btn"
                type="button"
                onclick="document.getElementById('create-permission-modal')?.close()"
              >
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M5 5l10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  <path d="M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                Cancelar
              </button>
              <button class="btn app-fixed-btn app-fixed-create permissions-action-btn min-w-40" type="submit">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M10 4v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  <path d="M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                Crear permiso
              </button>
            </div>
          </form>
        </div>
        <form method="dialog" class="modal-backdrop"><button>Cerrar</button></form>
      </dialog>
    @endif

    @if(authPermissions?.includes('permissions.manage') && (errors?.has('slug') || errors?.has('name')))
      <script>
        window.addEventListener('DOMContentLoaded', () => {
          document.getElementById('create-permission-modal')?.showModal()
        })
      </script>
    @endif

    @if(authPermissions?.includes('permissions.manage') && flashMessages.get('openEditPermissionModalId'))
      <script>
        window.addEventListener('DOMContentLoaded', () => {
          const permissionId = String({{ flashMessages.get('openEditPermissionModalId') }})
          document.getElementById(`edit-permission-modal-${permissionId}`)?.showModal()
        })
      </script>
    @endif

    <div class="surface-card">
      <div class="surface-card-body app-table-panel overflow-x-auto">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="permissions-table-title">Listado de permisos</h2>
          <span class="badge badge-outline">{{ permissionStats.totalPermissions }} registros</span>
        </div>

        <table class="app-data-table table table-zebra">
          <thead>
            <tr>
              <th>ID</th>
              <th>Slug</th>
              <th>Nombre</th>
              <th>Roles</th>
              @if(authPermissions?.includes('permissions.manage'))
                <th>Acciones</th>
              @endif
            </tr>
          </thead>
          <tbody>
            @if(permissions.length === 0)
              <tr>
                <td colspan="{{ authPermissions?.includes('permissions.manage') ? '5' : '4' }}" class="text-center text-base-content opacity-70">
                  Sin permisos registrados.
                </td>
              </tr>
            @endif

            @each(permission in permissions)
              <tr>
                <td>{{ permission.id }}</td>
                <td>{{ permission.slug }}</td>
                <td>{{ permission.name }}</td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    @if(permission.roles.length === 0)
                      <span class="badge badge-ghost permissions-empty-roles">sin roles</span>
                    @endif
                    @each(role in permission.roles)
                      <span class="badge badge-outline">{{ role.slug }}</span>
                    @end
                  </div>
                </td>
                @if(authPermissions?.includes('permissions.manage'))
                  <td>
                    <div class="flex flex-wrap gap-2">
                      <button
                        class="btn btn-sm app-fixed-btn app-fixed-edit permissions-action-btn"
                        type="button"
                        onclick="document.getElementById('edit-permission-modal-{{ permission.id }}')?.showModal()"
                      >
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                          <path d="M3.5 16.5l3.2-.7 8-8a1.8 1.8 0 0 0-2.5-2.5l-8 8-.7 3.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                          <path d="M11.3 5.7l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                        Editar
                      </button>

                      @if(!['admin.access', 'roles.manage', 'permissions.manage'].includes(permission.slug))
                        <form method="POST" action="/admin/permissions/{{ permission.id }}/delete">
                          @if(typeof csrfField === 'function')
                            {{ csrfField() }}
                          @endif
                          <button class="btn btn-sm app-danger-btn permissions-action-btn" type="submit">
                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                              <path d="M6.5 6.5l7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                              <path d="M13.5 6.5l-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            </svg>
                            Eliminar
                          </button>
                        </form>
                      @endif
                    </div>

                    <dialog id="edit-permission-modal-{{ permission.id }}" class="modal">
                      <div class="modal-box max-w-3xl app-form-panel app-modal-solid">
                        <h3 class="card-title app-section-title">Editar permiso #{{ permission.id }}</h3>
                        <p class="page-subtitle mt-1">Actualiza slug y nombre del permiso.</p>

                        <form class="app-form-grid mt-3 grid gap-4 md:grid-cols-2" method="POST" action="/admin/permissions/{{ permission.id }}/update">
                          @if(typeof csrfField === 'function')
                            {{ csrfField() }}
                          @endif

                          <label class="app-form-field form-control">
                            <div class="label"><span class="label-text">Slug</span></div>
                            <input
                              name="slug"
                              type="text"
                              class="input input-bordered app-strong-input w-full"
                              required
                              value="{{ String(flashMessages.get('openEditPermissionModalId') || '') === String(permission.id) ? (flashMessages.get('editPermissionForm')?.slug || permission.slug) : permission.slug }}"
                            />
                            <div class="label"><span class="label-text-alt">Usa minúsculas, puntos o guiones.</span></div>
                          </label>

                          <label class="app-form-field form-control">
                            <div class="label"><span class="label-text">Nombre</span></div>
                            <input
                              name="name"
                              type="text"
                              class="input input-bordered app-strong-input w-full"
                              required
                              value="{{ String(flashMessages.get('openEditPermissionModalId') || '') === String(permission.id) ? (flashMessages.get('editPermissionForm')?.name || permission.name) : permission.name }}"
                            />
                          </label>

                          <div class="md:col-span-2 flex justify-end gap-2">
                            <button
                              class="btn app-fixed-btn app-fixed-cancel permissions-action-btn"
                              type="button"
                              onclick="document.getElementById('edit-permission-modal-{{ permission.id }}')?.close()"
                            >
                              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                <path d="M5 5l10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                <path d="M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                              </svg>
                              Cancelar
                            </button>
                            <button class="btn app-fixed-btn app-fixed-edit permissions-action-btn min-w-40" type="submit">
                              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                <path d="M4.5 10.5l3.3 3.3L15.5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                              Guardar cambios
                            </button>
                          </div>
                        </form>
                      </div>
                      <form method="dialog" class="modal-backdrop"><button>Cerrar</button></form>
                    </dialog>
                  </td>
                @endif
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
@end
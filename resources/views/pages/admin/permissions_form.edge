@component('../views/components/layouts/app', { title: `${formMode === 'create' ? 'Crear Permiso' : 'Editar Permiso'} - proyecto-catedra-afe` })
  <div class="permissions-page page-stack">
    @if(flashMessages.get('success'))
      <div class="alert alert-success">
        <span>{{ flashMessages.get('success') }}</span>
      </div>
    @endif

    @if(flashMessages.get('error'))
      <div class="alert alert-error">
        <span>{{ flashMessages.get('error') }}</span>
      </div>
    @endif

    <div class="surface-card">
      <div class="surface-card-body">
        <section class="permissions-hero rounded-2xl p-5 md:p-6 lg:p-7">
          <div class="permissions-hero-grid gap-5 lg:gap-8">
            <div>
              <p class="permissions-kicker">Autorización granular</p>
              <h1 class="permissions-title mt-2">{{ formTitle }}</h1>
              <p class="permissions-lead mt-3">{{ formSubtitle }}</p>
            </div>

            <div class="permissions-actions flex flex-wrap items-center justify-end gap-2">
              <a class="btn app-fixed-btn app-fixed-view permissions-action-btn" href="{{ backHref }}">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3.5 10h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M10.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Volver al listado
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="surface-card">
      <div class="surface-card-body app-form-panel app-modal-solid permissions-form-shell permissions-form-panel">
        <form class="app-form-grid grid gap-4 md:grid-cols-2 xl:grid-cols-3" method="POST" action="{{ formAction }}">
          @if(typeof csrfField === 'function')
            {{ csrfField() }}
          @endif

          <label class="app-form-field form-control">
            <div class="label"><span class="label-text">Slug</span></div>
            <input
              name="slug"
              type="text"
              class="input input-bordered app-strong-input w-full @if(errors?.has('slug')) input-error @endif"
              required
              value="{{ old('slug') || (permission?.slug || '') }}"
            />
            <div class="label"><span class="label-text-alt">Usa minúsculas, puntos o guiones. Ejemplo: reports.export</span></div>
            @if(errors?.has('slug'))
              <div class="label"><span class="label-text-alt text-error">{{ errors.first('slug') }}</span></div>
            @endif
          </label>

          <label class="app-form-field form-control md:col-span-2 xl:col-span-2">
            <div class="label"><span class="label-text">Nombre</span></div>
            <input
              name="name"
              type="text"
              class="input input-bordered app-strong-input w-full @if(errors?.has('name')) input-error @endif"
              required
              value="{{ old('name') || (permission?.name || '') }}"
            />
            @if(errors?.has('name'))
              <div class="label"><span class="label-text-alt text-error">{{ errors.first('name') }}</span></div>
            @endif
          </label>

          <div class="md:col-span-2 xl:col-span-3 flex flex-wrap justify-end gap-2">
            <a class="btn app-fixed-btn app-fixed-cancel permissions-action-btn" href="{{ backHref }}">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 5l10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <path d="M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
              Cancelar
            </a>
            <button class="btn app-fixed-btn {{ formMode === 'create' ? 'app-fixed-create' : 'app-fixed-edit' }} permissions-action-btn min-w-40" type="submit">
              @if(formMode === 'create')
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M10 4v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  <path d="M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              @else
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4.5 10.5l3.3 3.3L15.5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              @endif
              {{ submitLabel }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
@end

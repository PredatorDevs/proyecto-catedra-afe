@component('../views/components/layouts/app', { title: 'Audit Logs - proyecto-catedra-afe' })
  <div class="page-stack">
    <div class="surface-card">
      <div class="surface-card-body">
        <h1 class="page-title">Audit Logs</h1>
        <p class="page-subtitle">Eventos recientes de autenticación y acciones clave del sistema.</p>
      </div>
    </div>

    <div class="surface-card">
      <div class="surface-card-body overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Usuario</th>
              <th>Acción</th>
              <th>Entidad</th>
              <th>Entity ID</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody>
            @if(auditLogs.length === 0)
              <tr>
                <td colspan="6" class="text-center text-base-content opacity-70">Sin registros todavía.</td>
              </tr>
            @endif

            @each(log in auditLogs)
              <tr>
                <td>{{ log.createdAt.toFormat('yyyy-LL-dd HH:mm:ss') }}</td>
                <td>{{ log.user?.email || 'Anónimo/Sistema' }}</td>
                <td><span class="badge badge-outline">{{ log.action }}</span></td>
                <td>{{ log.entity }}</td>
                <td>{{ log.entityId || '-' }}</td>
                <td>{{ log.ip || '-' }}</td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
@end

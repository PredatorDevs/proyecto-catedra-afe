    <div class="surface-card">
      <div class="surface-card-body app-table-panel">
        <form class="audit-filters-grid mb-4 grid gap-3 md:grid-cols-2 xl:grid-cols-5" method="GET" action="/admin/audit-logs">
          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Acción</span></div>
            <select name="action" class="select select-bordered app-strong-input w-full">
              <option value="">Todas</option>
              @each(action in filterOptions.actions)
                <option value="{{ action }}" {{ filters.action === action ? 'selected' : '' }}>{{ action }}</option>
              @end
            </select>
          </label>

          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Entidad</span></div>
            <select name="entity" class="select select-bordered app-strong-input w-full">
              <option value="">Todas</option>
              @each(entity in filterOptions.entities)
                <option value="{{ entity }}" {{ filters.entity === entity ? 'selected' : '' }}>{{ entity }}</option>
              @end
            </select>
          </label>

          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Desde</span></div>
            <input name="from" type="date" class="input input-bordered app-strong-input w-full" value="{{ filters.from || '' }}" />
          </label>

          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Hasta</span></div>
            <input name="to" type="date" class="input input-bordered app-strong-input w-full" value="{{ filters.to || '' }}" />
          </label>

          <div class="flex items-end gap-2">
            <button class="btn app-fixed-btn app-fixed-view audit-action-btn w-full" type="submit">
              Filtrar
            </button>
            <a class="btn app-fixed-btn app-fixed-cancel audit-action-btn" href="/admin/audit-logs">Limpiar</a>
          </div>
        </form>

        <div class="overflow-x-auto">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="audit-table-title">Eventos recientes</h2>
          <span class="badge badge-outline">{{ pagination.total }} registros</span>
        </div>

        <table class="app-data-table table table-zebra">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Usuario</th>
              <th>Acción</th>
              <th>Entidad</th>
              <th>Entity ID</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody>
            @if(auditLogs.length === 0)
              <tr>
                <td colspan="6" class="text-center text-base-content opacity-70">Sin registros todavía.</td>
              </tr>
            @endif

            @each(log in auditLogs)
              <tr>
                <td>{{ log.createdAt.toFormat('yyyy-LL-dd HH:mm:ss') }}</td>
                <td>{{ log.user?.email || 'Anónimo/Sistema' }}</td>
                <td>
                  <span class="badge badge-outline audit-action-badge">
                    {{ log.action }}
                  </span>
                </td>
                <td>{{ log.entity }}</td>
                <td>{{ log.entityId || '-' }}</td>
                <td>{{ log.ip || '-' }}</td>
              </tr>
            @end
          </tbody>
        </table>
        </div>

        @if(pagination.hasPages)
          <div class="audit-pagination mt-4 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm opacity-80">
              Página {{ pagination.currentPage }} de {{ pagination.lastPage }}
            </p>

            <div class="join">
              @if(pagination.prevUrl)
                <a class="join-item btn btn-sm" href="{{ pagination.prevUrl }}">Anterior</a>
              @else
                <button class="join-item btn btn-sm" type="button" disabled>Anterior</button>
              @endif

              @each(pageNum in pagination.pages)
                @if(pageNum === pagination.currentPage)
                  <button class="join-item btn btn-sm btn-active" type="button">{{ pageNum }}</button>
                @else
                  <a class="join-item btn btn-sm" href="{{ pagination.pageUrls[pageNum] }}">{{ pageNum }}</a>
                @endif
              @end

              @if(pagination.nextUrl)
                <a class="join-item btn btn-sm" href="{{ pagination.nextUrl }}">Siguiente</a>
              @else
                <button class="join-item btn btn-sm" type="button" disabled>Siguiente</button>
              @endif
            </div>
          </div>
        @endif
      </div>
    </div>

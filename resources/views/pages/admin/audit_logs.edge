@component('../views/components/layouts/app', { title: 'Audit Logs - proyecto-catedra-afe' })
  <div class="space-y-4">
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h1 class="text-2xl font-bold">Audit Logs</h1>
        <p>Eventos recientes de autenticación y acciones clave del sistema.</p>
      </div>
    </div>

    <div class="card bg-base-100 shadow">
      <div class="card-body overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Usuario</th>
              <th>Acción</th>
              <th>Entidad</th>
              <th>Entity ID</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody>
            @if(auditLogs.length === 0)
              <tr>
                <td colspan="6" class="text-center text-base-content/70">Sin registros todavía.</td>
              </tr>
            @endif

            @each(log in auditLogs)
              <tr>
                <td>{{ log.createdAt.toFormat('yyyy-LL-dd HH:mm:ss') }}</td>
                <td>{{ log.user?.email || 'Anónimo/Sistema' }}</td>
                <td><span class="badge badge-outline">{{ log.action }}</span></td>
                <td>{{ log.entity }}</td>
                <td>{{ log.entityId || '-' }}</td>
                <td>{{ log.ip || '-' }}</td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
@end

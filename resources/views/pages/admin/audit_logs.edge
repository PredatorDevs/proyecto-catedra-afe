@component('../views/components/layouts/app', { title: 'Audit Logs - proyecto-catedra-afe' })
  <div class="audit-page page-stack">
    <div class="surface-card">
      <div class="surface-card-body">
        <section class="audit-hero rounded-2xl p-5 md:p-6 lg:p-7">
          <div class="audit-hero-grid gap-5 lg:gap-8">
            <div>
              <p class="audit-kicker">Trazabilidad operativa</p>
              <h1 class="audit-title mt-2">Audit Logs</h1>
              <p class="audit-lead mt-3">
                Monitorea eventos recientes de autenticación y cambios críticos del sistema para mantener
                control, transparencia y seguimiento administrativo.
              </p>
            </div>

            <div class="audit-actions flex flex-wrap items-center justify-end gap-2">
              <a class="btn app-fixed-btn app-fixed-view audit-action-btn" href="/admin/users">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3.5 10h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M10.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Ver Usuarios
              </a>
              <a class="btn app-fixed-btn app-fixed-view audit-action-btn" href="/admin/roles">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3.5 10h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M10.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Ver Roles
              </a>
            </div>
          </div>
        </section>

        <section class="audit-kpi-grid mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
          <article class="audit-kpi-card rounded-xl p-4">
            <p class="audit-kpi-label">Registros cargados</p>
            <p class="audit-kpi-value">{{ auditStats.total }}</p>
          </article>
          <article class="audit-kpi-card rounded-xl p-4">
            <p class="audit-kpi-label">Creaciones</p>
            <p class="audit-kpi-value">{{ auditStats.create }}</p>
          </article>
          <article class="audit-kpi-card rounded-xl p-4">
            <p class="audit-kpi-label">Actualizaciones</p>
            <p class="audit-kpi-value">{{ auditStats.update }}</p>
          </article>
          <article class="audit-kpi-card rounded-xl p-4">
            <p class="audit-kpi-label">Eliminaciones</p>
            <p class="audit-kpi-value">{{ auditStats.delete }}</p>
          </article>
          <article class="audit-kpi-card rounded-xl p-4">
            <p class="audit-kpi-label">Eventos de acceso</p>
            <p class="audit-kpi-value">{{ auditStats.auth }}</p>
          </article>
        </section>
      </div>
    </div>

    <div class="surface-card">
      <div class="surface-card-body app-table-panel">
        <form class="audit-filters-grid mb-4 grid gap-3 md:grid-cols-2 xl:grid-cols-6" method="GET" action="/admin/audit-logs">
          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Acción</span></div>
            <select name="action" class="select select-bordered app-strong-input w-full">
              <option value="">Todas</option>
              @each(action in filterOptions.actions)
                <option value="{{ action }}" {{ filters.action === action ? 'selected' : '' }}>{{ action }}</option>
              @end
            </select>
          </label>

          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Entidad</span></div>
            <select name="entity" class="select select-bordered app-strong-input w-full">
              <option value="">Todas</option>
              @each(entity in filterOptions.entities)
                <option value="{{ entity }}" {{ filters.entity === entity ? 'selected' : '' }}>{{ entity }}</option>
              @end
            </select>
          </label>

          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Desde</span></div>
            <input name="from" type="date" class="input input-bordered app-strong-input w-full" value="{{ filters.from || '' }}" />
          </label>

          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Hasta</span></div>
            <input name="to" type="date" class="input input-bordered app-strong-input w-full" value="{{ filters.to || '' }}" />
          </label>

          <label class="form-control">
            <div class="label pb-1"><span class="label-text font-medium">Resultados por página</span></div>
            <select name="perPage" class="select select-bordered app-strong-input w-full">
              @each(size in filterOptions.perPage)
                <option value="{{ size }}" {{ Number(filters.perPage) === Number(size) ? 'selected' : '' }}>{{ size }}</option>
              @end
            </select>
          </label>

          <div class="flex items-end gap-2">
            <button class="btn app-fixed-btn app-fixed-view audit-action-btn w-full" type="submit">
              Filtrar
            </button>
            <a class="btn app-fixed-btn app-fixed-cancel audit-action-btn" href="/admin/audit-logs">Limpiar</a>
          </div>
        </form>

        <div class="overflow-x-auto">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="audit-table-title">Eventos recientes</h2>
          <span class="badge badge-outline">{{ pagination.total }} registros · {{ pagination.perPage }} por página</span>
        </div>

        <table class="app-data-table table table-zebra">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Usuario</th>
              <th>Acción</th>
              <th>Entidad</th>
              <th>Entity ID</th>
              <th>Cambios</th>
              <th>IP</th>
            </tr>
          </thead>
          <tbody>
            @if(auditLogs.length === 0)
              <tr>
                <td colspan="7" class="text-center text-base-content opacity-70">Sin registros todavía.</td>
              </tr>
            @endif

            @each(log in auditLogs)
              <tr>
                <td>{{ log.createdAt.toFormat('yyyy-LL-dd HH:mm:ss') }}</td>
                <td>{{ log.user?.email || 'Anónimo/Sistema' }}</td>
                <td>
                  <span class="badge badge-outline audit-action-badge">
                    {{ log.action }}
                  </span>
                </td>
                <td>{{ log.entity }}</td>
                <td>{{ log.entityId || '-' }}</td>
                <td>
                  <div class="flex flex-wrap items-center gap-1.5">
                    @if(log.changedFields && log.changedFields.length)
                      @each(field in log.changedFields)
                        <span class="badge badge-outline audit-change-badge">{{ field }}</span>
                      @end
                    @else
                      <span class="text-xs opacity-65">sin diff</span>
                    @endif

                    <button
                      class="btn btn-xs app-fixed-btn app-fixed-view audit-detail-btn"
                      type="button"
                      onclick="document.getElementById('audit-detail-{{ log.id }}')?.showModal()"
                    >
                      Ver
                    </button>
                  </div>

                  <dialog id="audit-detail-{{ log.id }}" class="modal">
                    <div class="modal-box max-w-5xl app-form-panel app-modal-solid audit-detail-modal">
                      <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
                        <div>
                          <h3 class="card-title app-section-title">Detalle de cambio #{{ log.id }}</h3>
                          <p class="page-subtitle mt-1">{{ log.action }} · {{ log.entity }} · {{ log.createdAt.toFormat('yyyy-LL-dd HH:mm:ss') }}</p>
                        </div>
                        <button class="btn btn-sm app-fixed-btn app-fixed-cancel audit-detail-btn" type="button" onclick="document.getElementById('audit-detail-{{ log.id }}')?.close()">Cerrar</button>
                      </div>

                      <div class="mb-3 flex flex-wrap gap-1.5">
                        @if(log.changedFields && log.changedFields.length)
                          @each(field in log.changedFields)
                            <span class="badge badge-outline audit-change-badge">{{ field }}</span>
                          @end
                        @else
                          <span class="text-xs opacity-65">No hay campos detectados como cambiados.</span>
                        @endif
                      </div>

                      <div class="grid gap-3 md:grid-cols-2">
                        <div class="audit-detail-block">
                          <p class="audit-detail-label">Old Values</p>
                          <pre class="audit-detail-json">{{ JSON.stringify(log.oldValues || {}, null, 2) }}</pre>
                        </div>
                        <div class="audit-detail-block">
                          <p class="audit-detail-label">New Values</p>
                          <pre class="audit-detail-json">{{ JSON.stringify(log.newValues || {}, null, 2) }}</pre>
                        </div>
                      </div>
                    </div>
                    <form method="dialog" class="modal-backdrop"><button>Cerrar</button></form>
                  </dialog>
                </td>
                <td>{{ log.ip || '-' }}</td>
              </tr>
            @end
          </tbody>
        </table>
        </div>

        @if(pagination.hasPages)
          <div class="audit-pagination mt-4 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm opacity-80">
              Página {{ pagination.currentPage }} de {{ pagination.lastPage }}
            </p>

            <div class="audit-pagination-controls">
              @if(pagination.prevUrl)
                <a class="btn btn-sm audit-page-btn" href="{{ pagination.prevUrl }}">Anterior</a>
              @else
                <button class="btn btn-sm audit-page-btn" type="button" disabled>Anterior</button>
              @endif

              @each(pageNum in pagination.pages)
                @if(pageNum === pagination.currentPage)
                  <button class="btn btn-sm btn-active audit-page-btn" type="button">{{ pageNum }}</button>
                @else
                  <a class="btn btn-sm audit-page-btn" href="{{ pagination.pageUrls[pageNum] }}">{{ pageNum }}</a>
                @endif
              @end

              @if(pagination.nextUrl)
                <a class="btn btn-sm audit-page-btn" href="{{ pagination.nextUrl }}">Siguiente</a>
              @else
                <button class="btn btn-sm audit-page-btn" type="button" disabled>Siguiente</button>
              @endif
            </div>
          </div>
        @endif
      </div>
    </div>
  </div>
@end

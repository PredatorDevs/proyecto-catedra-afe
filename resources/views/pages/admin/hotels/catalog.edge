@component('../views/components/layouts/app', { title: `${pageTitle} - proyecto-catedra-afe` })
  <div class="users-page page-stack">
    @if(flashMessages.get('success'))
      <div class="alert alert-success">
        <span>{{ flashMessages.get('success') }}</span>
      </div>
    @endif

    @if(flashMessages.get('error'))
      <div class="alert alert-error">
        <span>{{ flashMessages.get('error') }}</span>
      </div>
    @endif

    <div class="surface-card">
      <div class="surface-card-body">
        <section class="users-hero rounded-2xl p-5 md:p-6 lg:p-7">
          <div class="users-hero-grid gap-5 lg:gap-8">
            <div>
              <p class="users-kicker">{{ pageKicker }}</p>
              <h1 class="users-title mt-2">{{ pageTitle }}</h1>
              <p class="users-lead mt-3">{{ pageSubtitle }}</p>
            </div>

            <div class="users-actions flex flex-wrap items-center justify-end gap-2">
              <a class="btn app-fixed-btn app-fixed-create users-action-btn min-w-44" href="{{ createHref }}">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M10 4v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  <path d="M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                {{ createLabel }}
              </a>
              <a class="btn app-fixed-btn app-fixed-view users-action-btn" href="/admin/hotels">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3.5 10h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M10.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Ver módulos hotel
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>

    <div class="surface-card">
      <div class="surface-card-body app-table-panel overflow-x-auto">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="users-table-title">Listado</h2>
          <span class="badge badge-outline">{{ rows.length }} registros</span>
        </div>

        <table class="app-data-table table table-zebra">
          <thead>
            <tr>
              @each(column in columns)
                <th>{{ column.label }}</th>
              @end
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            @if(rows.length === 0)
              <tr>
                <td colspan="{{ columns.length + 1 }}" class="text-center text-base-content opacity-70">Sin registros.</td>
              </tr>
            @endif

            @each(row in rows)
              <tr>
                @each(column in columns)
                  <td>
                    @if(column.badge)
                      <span class="badge badge-outline">{{ row[column.key] ?? '-' }}</span>
                    @else
                      {{ row[column.key] ?? '-' }}
                    @endif
                  </td>
                @end
                <td>
                  <div class="flex flex-wrap items-center gap-2">
                    <a class="btn app-fixed-btn app-fixed-edit users-action-btn" href="{{ editBaseHref }}/{{ row.id }}/edit">
                      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M3.5 16.5l3.2-.7 8-8a1.8 1.8 0 0 0-2.5-2.5l-8 8-.7 3.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                        <path d="M11.3 5.7l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                      </svg>
                      Editar
                    </a>

                    @if(cancellationModal && row.canCancel)
                      <button
                        type="button"
                        class="btn btn-error btn-outline users-action-btn"
                        data-cancel-trigger
                        data-cancel-id="{{ row.id }}"
                        data-cancel-label="{{ row.reservationNumber ?? row.id }}"
                      >
                        Cancelar
                      </button>
                    @endif
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>

    @if(cancellationModal)
      <dialog id="reservationCancelModal" class="modal">
        <div class="modal-box max-w-xl">
          <h3 class="font-semibold text-lg">{{ cancellationModal.title }}</h3>
          <p class="mt-2 text-sm opacity-80">
            Se cancelará la reservación <span class="font-semibold" data-cancel-target-label>#-</span>.
            Indica el motivo para dejar trazabilidad.
          </p>

          <form id="reservationCancelForm" method="POST" class="mt-4 space-y-3">
            {{{ csrfField() }}}
            <label class="form-control w-full">
              <span class="label-text">Motivo de cancelación</span>
              <textarea
                name="cancellationReason"
                class="textarea textarea-bordered min-h-28"
                minlength="5"
                maxlength="500"
                required
                placeholder="Describe por qué se cancela la reservación"
              ></textarea>
            </label>

            <div class="modal-action mt-5">
              <button type="submit" class="btn btn-error">Confirmar cancelación</button>
              <button type="button" class="btn" data-cancel-close>Cerrar</button>
            </div>
          </form>
        </div>
      </dialog>
    @endif
  </div>
@end

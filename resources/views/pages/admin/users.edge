@component('../views/components/layouts/app', { title: 'Admin Users - proyecto-catedra-afe' })
  <div class="users-page page-stack">
    @if(flashMessages.get('success'))
      <div class="alert alert-success">
        <span>{{ flashMessages.get('success') }}</span>
      </div>
    @endif

    @if(flashMessages.get('error'))
      <div class="alert alert-error">
        <span>{{ flashMessages.get('error') }}</span>
      </div>
    @endif

    <div class="surface-card">
      <div class="surface-card-body">
        <section class="users-hero rounded-2xl p-5 md:p-6 lg:p-7">
          <div class="users-hero-grid gap-5 lg:gap-8">
            <div>
              <p class="users-kicker">Administración de identidades</p>
              <h1 class="users-title mt-2">Gestión de usuarios internos</h1>
              <p class="users-lead mt-3">
                Administra altas, actualizaciones y asignación de roles desde un flujo centralizado, con
                trazabilidad y permisos por política.
              </p>
            </div>

            <div class="users-actions flex flex-wrap items-center justify-end gap-2">
              @if(authPermissions?.includes('users.manage'))
                <a class="btn app-fixed-btn app-fixed-create users-action-btn min-w-44" href="/admin/users/new">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 4v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                  Nuevo Usuario
                </a>
              @endif
              <a class="btn app-fixed-btn app-fixed-view users-action-btn" href="/admin/roles">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3.5 10h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M10.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Ver Roles
              </a>
            </div>
          </div>
        </section>

        <section class="users-kpi-grid mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <article class="users-kpi-card rounded-xl p-4">
            <p class="users-kpi-label">Total usuarios</p>
            <p class="users-kpi-value">{{ userStats.totalUsers }}</p>
          </article>

          <article class="users-kpi-card rounded-xl p-4">
            <p class="users-kpi-label">Con roles asignados</p>
            <p class="users-kpi-value">{{ userStats.usersWithRoles }}</p>
          </article>

          <article class="users-kpi-card rounded-xl p-4">
            <p class="users-kpi-label">Sin rol asignado</p>
            <p class="users-kpi-value">{{ userStats.usersWithoutRoles }}</p>
          </article>

          <article class="users-kpi-card rounded-xl p-4">
            <p class="users-kpi-label">Roles disponibles</p>
            <p class="users-kpi-value">{{ userStats.totalRoles }}</p>
          </article>
        </section>
      </div>
    </div>

    <div class="surface-card">
      <div class="surface-card-body app-table-panel overflow-x-auto">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="users-table-title">Listado de usuarios</h2>
          <span class="badge badge-outline">{{ userStats.totalUsers }} registros</span>
        </div>

        <table class="app-data-table table table-zebra">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nombre</th>
              <th>Email</th>
              <th>Roles</th>
              <th>Creado</th>
              @if(authPermissions?.includes('users.manage'))
                <th>Acciones</th>
              @endif
            </tr>
          </thead>
          <tbody>
            @if(users.length === 0)
              <tr>
                <td colspan="{{ authPermissions?.includes('users.manage') ? '6' : '5' }}" class="text-center text-base-content opacity-70">Sin usuarios registrados.</td>
              </tr>
            @endif

            @each(user in users)
              <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.fullName || '-' }}</td>
                <td>{{ user.email }}</td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    @if(user.roles.length === 0)
                      <span class="badge badge-ghost users-empty-role">sin rol</span>
                    @endif
                    @each(role in user.roles)
                      <span class="badge badge-outline">{{ role.slug }}</span>
                    @end
                  </div>
                </td>
                <td>{{ user.createdAt.toFormat('yyyy-LL-dd HH:mm:ss') }}</td>
                @if(authPermissions?.includes('users.manage'))
                  <td>
                    <a class="btn app-fixed-btn app-fixed-edit users-action-btn" href="/admin/users/{{ user.id }}/edit">
                      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M3.5 16.5l3.2-.7 8-8a1.8 1.8 0 0 0-2.5-2.5l-8 8-.7 3.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                        <path d="M11.3 5.7l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                      </svg>
                      Editar
                    </a>
                  </td>
                @endif
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
@end

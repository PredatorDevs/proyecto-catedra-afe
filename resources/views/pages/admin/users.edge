    <div class="surface-card">
      <div class="surface-card-body app-table-panel overflow-x-auto">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="users-table-title">Listado de usuarios</h2>
          <span class="badge badge-outline">{{ userStats.totalUsers }} registros</span>
        </div>

        <table class="app-data-table table table-zebra">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nombre</th>
              <th>Email</th>
              <th>Roles</th>
              <th>Creado</th>
              @if(authPermissions?.includes('users.manage'))
                <th>Acciones</th>
              @endif
            </tr>
          </thead>
          <tbody>
            @if(users.length === 0)
              <tr>
                <td colspan="{{ authPermissions?.includes('users.manage') ? '6' : '5' }}" class="text-center text-base-content opacity-70">Sin usuarios registrados.</td>
              </tr>
            @endif

            @each(user in users)
              <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.fullName || '-' }}</td>
                <td>{{ user.email }}</td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    @if(user.roles.length === 0)
                      <span class="badge badge-ghost users-empty-role">sin rol</span>
                    @endif
                    @each(role in user.roles)
                      <span class="badge badge-outline">{{ role.slug }}</span>
                    @end
                  </div>
                </td>
                <td>{{ user.createdAt.toFormat('yyyy-LL-dd HH:mm:ss') }}</td>
                @if(authPermissions?.includes('users.manage'))
                  <td>
                    <button
                      class="btn btn-info btn-sm"
                      type="button"
                      onclick="document.getElementById('edit-user-modal-{{ user.id }}')?.showModal()"
                    >
                      Editar
                    </button>

                    <dialog id="edit-user-modal-{{ user.id }}" class="modal">
                      <div class="modal-box max-w-3xl app-form-panel">
                        <h3 class="card-title app-section-title">Editar usuario #{{ user.id }}</h3>
                        <p class="page-subtitle mt-1">Actualiza datos y asignaciones de rol.</p>

                        <form class="app-form-grid mt-3 grid gap-4 md:grid-cols-2" method="POST" action="/admin/users/{{ user.id }}/update">
                          @if(typeof csrfField === 'function')
                            {{ csrfField() }}
                          @endif

                          <label class="app-form-field form-control">
                            <div class="label"><span class="label-text">Nombre completo</span></div>
                            <input
                              name="fullName"
                              type="text"
                              class="input input-bordered app-strong-input w-full"
                              required
                              value="{{ user.fullName || '' }}"
                            />
                          </label>

                          <label class="app-form-field form-control">
                            <div class="label"><span class="label-text">Email</span></div>
                            <input
                              name="email"
                              type="email"
                              class="input input-bordered app-strong-input w-full"
                              required
                              value="{{ user.email }}"
                            />
                          </label>

                          <label class="app-form-field form-control md:col-span-2">
                            <div class="label"><span class="label-text">Nueva password (opcional)</span></div>
                            <input
                              name="password"
                              type="password"
                              class="input input-bordered app-strong-input w-full"
                              minlength="8"
                              placeholder="Dejar vacio para conservar la password actual"
                            />
                          </label>

                          <label class="app-form-field form-control md:col-span-2">
                            <div class="label"><span class="label-text">Roles</span></div>
                            <select name="roleIds" multiple class="select select-bordered app-strong-input h-32 w-full">
                              @each(role in roles)
                                <option
                                  value="{{ role.id }}"
                                  {{ userRoleIdsByUserId[user.id]?.includes(role.id) ? 'selected' : '' }}
                                >
                                  {{ role.name }} ({{ role.slug }})
                                </option>
                              @end
                            </select>
                            <div class="label"><span class="label-text-alt">Mantén presionada Ctrl para seleccionar varios roles.</span></div>

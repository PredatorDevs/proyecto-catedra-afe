@component('../views/components/layouts/app', { title: 'Admin Roles - proyecto-catedra-afe' })
  <div class="page-stack">
    <div class="surface-card">
      <div class="surface-card-body">
        <h1 class="page-title">Roles</h1>
        <p class="page-subtitle">Listado básico de roles y permisos asignados.</p>
      </div>
    </div>

    <div class="surface-card">
      <div class="surface-card-body overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>ID</th>
              <th>Slug</th>
              <th>Nombre</th>
              <th>Permisos</th>
            </tr>
          </thead>
          <tbody>
            @if(roles.length === 0)
              <tr>
                <td colspan="4" class="text-center text-base-content opacity-70">Sin roles registrados.</td>
              </tr>
            @endif

            @each(role in roles)
              <tr>
                <td>{{ role.id }}</td>
                <td>{{ role.slug }}</td>
                <td>{{ role.name }}</td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    @if(role.permissions.length === 0)
                      <span class="badge badge-ghost">sin permisos</span>
                    @endif
                    @each(permission in role.permissions)
                      <span class="badge badge-outline">{{ permission.slug }}</span>
                    @end
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
@end

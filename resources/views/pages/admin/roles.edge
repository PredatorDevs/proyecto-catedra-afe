      <div class="alert alert-error">
        <span>{{ flashMessages.get('error') }}</span>
      </div>
    @endif

    <div class="surface-card">
      <div class="surface-card-body">
        <section class="roles-hero rounded-2xl p-5 md:p-6 lg:p-7">
          <div class="roles-hero-grid gap-5 lg:gap-8">
            <div>
              <p class="roles-kicker">Control de autorizaciones</p>
              <h1 class="roles-title mt-2">Gestión de roles</h1>
              <p class="roles-lead mt-3">
                Define perfiles operativos y mantén una asignación clara de permisos para asegurar un acceso
                consistente a cada módulo del sistema.
              </p>
            </div>

            <div class="roles-actions flex flex-wrap items-center justify-end gap-2">
              @if(authPermissions?.includes('roles.manage'))
                <a class="btn app-fixed-btn app-fixed-create roles-action-btn min-w-44" href="/admin/roles/new">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M10 4v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    <path d="M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                  Nuevo Rol
                </a>
              @endif
              <a class="btn app-fixed-btn app-fixed-view roles-action-btn" href="/admin/permissions">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3.5 10h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                  <path d="M10.5 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Ver Permisos
              </a>
            </div>
          </div>
        </section>

        <section class="roles-kpi-grid mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <article class="roles-kpi-card rounded-xl p-4">
            <p class="roles-kpi-label">Total roles</p>
            <p class="roles-kpi-value">{{ roleStats.totalRoles }}</p>
          </article>

          <article class="roles-kpi-card rounded-xl p-4">
            <p class="roles-kpi-label">Con permisos</p>
            <p class="roles-kpi-value">{{ roleStats.rolesWithPermissions }}</p>
          </article>

          <article class="roles-kpi-card rounded-xl p-4">
            <p class="roles-kpi-label">Sin permisos</p>
            <p class="roles-kpi-value">{{ roleStats.rolesWithoutPermissions }}</p>
          </article>

          <article class="roles-kpi-card rounded-xl p-4">
            <p class="roles-kpi-label">Permisos disponibles</p>
            <p class="roles-kpi-value">{{ roleStats.totalPermissions }}</p>
          </article>
        </section>
      </div>
    </div>

    <div class="surface-card">
      <div class="surface-card-body app-table-panel overflow-x-auto">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="roles-table-title">Listado de roles</h2>
          <span class="badge badge-outline">{{ roleStats.totalRoles }} registros</span>
        </div>

        <table class="app-data-table table table-zebra">
          <thead>
            <tr>
              <th>ID</th>
              <th>Slug</th>
              <th>Nombre</th>
              <th>Permisos</th>
              @if(authPermissions?.includes('roles.manage'))
                <th>Acciones</th>
              @endif
            </tr>
          </thead>
          <tbody>
            @if(roles.length === 0)
              <tr>
                <td colspan="{{ authPermissions?.includes('roles.manage') ? '5' : '4' }}" class="text-center text-base-content opacity-70">
                  Sin roles registrados.
                </td>
              </tr>
            @endif

            @each(role in roles)
              <tr>
                <td>{{ role.id }}</td>
                <td>{{ role.slug }}</td>
                <td>{{ role.name }}</td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    @if(role.permissions.length === 0)
                      <span class="badge badge-ghost roles-empty-permissions">sin permisos</span>
                    @endif
                    @each(permission in role.permissions)
                      <span class="badge badge-outline">{{ permission.slug }}</span>
                    @end
                  </div>
                </td>
                @if(authPermissions?.includes('roles.manage'))
                  <td>
                    <div class="flex flex-wrap gap-2">
                      <a class="btn btn-sm app-fixed-btn app-fixed-edit roles-action-btn" href="/admin/roles/{{ role.id }}/edit">
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                          <path d="M3.5 16.5l3.2-.7 8-8a1.8 1.8 0 0 0-2.5-2.5l-8 8-.7 3.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                          <path d="M11.3 5.7l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                        Editar
                      </a>

                      <a class="btn btn-sm app-fixed-btn app-fixed-view roles-action-btn" href="/admin/roles/{{ role.id }}/permissions">
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                          <rect x="3.5" y="4" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.6"></rect>
                          <path d="M7 8.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                          <path d="M7 11.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                        </svg>
                        Permisos
                      </a>

                      @if(role.slug !== 'admin')
                        <form method="POST" action="/admin/roles/{{ role.id }}/delete">
                          @if(typeof csrfField === 'function')
                            {{ csrfField() }}
                          @endif
                          <button class="btn btn-sm app-danger-btn roles-action-btn" type="submit">
                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                              <path d="M6.5 6.5l7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                              <path d="M13.5 6.5l-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            </svg>
                            Eliminar
                          </button>
                        </form>
                      @endif
                    </div>

                  </td>
                @endif
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
@end
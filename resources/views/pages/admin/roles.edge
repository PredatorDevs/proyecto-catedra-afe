    <div class="surface-card">
      <div class="surface-card-body app-table-panel overflow-x-auto">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <h2 class="roles-table-title">Listado de roles</h2>
          <span class="badge badge-outline">{{ roleStats.totalRoles }} registros</span>
        </div>

        <table class="app-data-table table table-zebra">
          <thead>
            <tr>
              <th>ID</th>
              <th>Slug</th>
              <th>Nombre</th>
              <th>Permisos</th>
              @if(authPermissions?.includes('roles.manage'))
                <th>Acciones</th>
              @endif
            </tr>
          </thead>
          <tbody>
            @if(roles.length === 0)
              <tr>
                <td colspan="{{ authPermissions?.includes('roles.manage') ? '5' : '4' }}" class="text-center text-base-content opacity-70">
                  Sin roles registrados.
                </td>
              </tr>
            @endif

            @each(role in roles)
              <tr>
                <td>{{ role.id }}</td>
                <td>
                  @if(authPermissions?.includes('roles.manage'))
                    <input
                      form="update-role-{{ role.id }}"
                      name="slug"
                      type="text"
                      class="input input-bordered input-sm app-strong-input w-full"
                      value="{{ role.slug }}"
                    />
                  @else
                    {{ role.slug }}
                  @endif
                </td>
                <td>
                  @if(authPermissions?.includes('roles.manage'))
                    <input
                      form="update-role-{{ role.id }}"
                      name="name"
                      type="text"
                      class="input input-bordered input-sm app-strong-input w-full"
                      value="{{ role.name }}"
                    />
                  @else
                    {{ role.name }}
                  @endif
                </td>
                <td>
                  <div class="flex flex-wrap gap-1">
                    @if(role.permissions.length === 0)
                      <span class="badge badge-ghost roles-empty-permissions">sin permisos</span>
                    @endif
                    @each(permission in role.permissions)
                      <span class="badge badge-outline">{{ permission.slug }}</span>
                    @end
                  </div>
                </td>
                @if(authPermissions?.includes('roles.manage'))
                  <td>
                    <div class="flex flex-wrap gap-2">
                      <a class="btn btn-sm app-fixed-btn app-fixed-view roles-action-btn" href="/admin/roles/{{ role.id }}/permissions">
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                          <rect x="3.5" y="4" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.6"></rect>
                          <path d="M7 8.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                          <path d="M7 11.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
                        </svg>
                        Permisos
                      </a>

                      <form id="update-role-{{ role.id }}" method="POST" action="/admin/roles/{{ role.id }}/update">
                        @if(typeof csrfField === 'function')
                          {{ csrfField() }}
                        @endif
                        <button class="btn btn-sm app-fixed-btn app-fixed-edit roles-action-btn" type="submit">
                          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M4.5 10.5l3.3 3.3L15.5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          Guardar
                        </button>
                      </form>

                      @if(role.slug !== 'admin')
                        <form method="POST" action="/admin/roles/{{ role.id }}/delete">
                          @if(typeof csrfField === 'function')
                            {{ csrfField() }}
                          @endif
                          <button class="btn btn-sm app-danger-btn roles-action-btn" type="submit">
                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                              <path d="M6.5 6.5l7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                              <path d="M13.5 6.5l-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            </svg>
                            Eliminar
                          </button>
                        </form>
                      @endif
                    </div>
                  </td>
                @endif
              </tr>
            @end
          </tbody>
        </table>
      </div>
    </div>
  </div>
@end
    @if(authPermissions?.includes('roles.manage'))
      <dialog id="create-role-modal" class="modal">
        <div class="modal-box max-w-3xl app-form-panel app-modal-solid">
          <h3 class="card-title app-section-title">Crear rol</h3>
          <p class="page-subtitle mt-1">Los roles controlan grupos de permisos para el acceso interno.</p>

          <form class="app-form-grid mt-3 grid gap-4 md:grid-cols-2" method="POST" action="/admin/roles">
            @if(typeof csrfField === 'function')
              {{ csrfField() }}
            @endif

            <label class="app-form-field form-control">
              <div class="label"><span class="label-text">Slug</span></div>
              <input
                name="slug"
                type="text"
                class="input input-bordered app-strong-input w-full @if(errors?.has('slug')) input-error @endif"
                required
                value="{{ errors?.has('slug') ? (old('slug') || '') : '' }}"
              />
              @if(errors?.has('slug'))
                <div class="label"><span class="label-text-alt text-error">{{ errors.first('slug') }}</span></div>
              @endif
            </label>

            <label class="app-form-field form-control">
              <div class="label"><span class="label-text">Nombre</span></div>
              <input
                name="name"
                type="text"
                class="input input-bordered app-strong-input w-full @if(errors?.has('name')) input-error @endif"
                required
                value="{{ errors?.has('name') ? (old('name') || '') : '' }}"
              />
              @if(errors?.has('name'))
                <div class="label"><span class="label-text-alt text-error">{{ errors.first('name') }}</span></div>
              @endif
            </label>

            <div class="md:col-span-2 flex justify-end gap-2">
              <button
                class="btn app-fixed-btn app-fixed-cancel roles-action-btn"
                type="button"
                onclick="document.getElementById('create-role-modal')?.close()"
              >
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M5 5l10 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  <path d="M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                Cancelar
              </button>
              <button class="btn app-fixed-btn app-fixed-create roles-action-btn min-w-40" type="submit">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M10 4v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />

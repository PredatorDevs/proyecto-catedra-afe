@component('../views/components/layouts/auth', { title: 'Registro - proyecto-catedra-afe' })
  <div class="surface-card">
    <div class="surface-card-body">
      <h1 class="page-title">Crear cuenta</h1>
      <p class="page-subtitle">Registra un nuevo usuario para acceder al sistema.</p>

      @if(flashMessages.get('error'))
        <div class="alert alert-error mt-3">
          <span>{{ flashMessages.get('error') }}</span>
        </div>
      @endif

        <form class="mt-4 space-y-4" method="POST" action="/register">
            @if(typeof csrfField === 'function')
              {{ csrfField() }}
            @endif

            <label class="form-control">
                <div class="label"><span class="label-text">Email</span></div>
                <input
                name="email"
                type="email"
                class="input input-bordered w-full @if(errors?.has('email')) input-error @endif"
                required
                autofocus
                autocomplete="email"
                value="{{ old('email') || '' }}"
                />
                @if(errors?.has('email'))
                <div class="label"><span class="label-text-alt text-error">{{ errors.first('email') }}</span></div>
                @endif
            </label>

            <label class="form-control">
                <div class="label"><span class="label-text">Password (mínimo 8)</span></div>
                <input
                name="password"
                type="password"
                class="input input-bordered w-full @if(errors?.has('password')) input-error @endif"
                required
                minlength="8"
                autocomplete="new-password"
                />
                @if(errors?.has('password'))
                <div class="label"><span class="label-text-alt text-error">{{ errors.first('password') }}</span></div>
                @endif
            </label>

            <button class="btn btn-primary w-full" type="submit">Crear cuenta</button>

            <div class="text-sm mt-1 text-base-content/80">
                ¿Ya tienes cuenta? <a class="link" href="/login">Iniciar sesión</a>
            </div>
        </form>
    </div>
  </div>
@end
@component('../views/components/layouts/auth', { title: 'Login - proyecto-catedra-afe' })
  <div class="surface-card">
    <div class="surface-card-body">
      <h1 class="page-title">Iniciar sesión</h1>
      <p class="page-subtitle">Accede con tus credenciales para continuar.</p>

      @if(flashMessages.get('error'))
        <div class="alert alert-error mt-3">
          <span>{{ flashMessages.get('error') }}</span>
        </div>
      @endif

      <form class="mt-4 space-y-4" method="POST" action="/login">
        @if(typeof csrfField === 'function')
          {{ csrfField() }}
        @endif

        <label class="form-control">
            <div class="label"><span class="label-text">Email</span></div>
            <input
            name="email"
            type="email"
            class="input input-bordered w-full @if(errors?.has('email')) input-error @endif"
            required
            autofocus
            autocomplete="email"
            value="{{ old('email') || '' }}"
            />
            @if(errors?.has('email'))
            <div class="label"><span class="label-text-alt text-error">{{ errors.first('email') }}</span></div>
            @endif
        </label>

        <label class="form-control">
            <div class="label"><span class="label-text">Password</span></div>
            <input
            name="password"
            type="password"
            class="input input-bordered w-full @if(errors?.has('password')) input-error @endif"
            required
            autocomplete="current-password"
            />
            @if(errors?.has('password'))
            <div class="label"><span class="label-text-alt text-error">{{ errors.first('password') }}</span></div>
            @endif
        </label>

        <button class="btn btn-primary w-full" type="submit">Entrar</button>

        {{-- <div class="text-sm mt-1 text-base-content/80">
          La creación de usuarios se gestiona internamente por administración.
        </div> --}}
        </form>
    </div>
  </div>
@end